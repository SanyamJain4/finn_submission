# Copy to .env (never commit .env). All values are optional; FINN runs without an LLM.

# LLM routing: gemini | anthropic | openai (any OpenAI-compatible API: Groq, OpenRouter, OpenAI...) | none
FINN_LLM_PROVIDER=gemini
FINN_LLM_API_KEY=your-key-here
# Optional overrides. Defaults: gemini -> gemini-2.5-flash-lite / gemini-2.5-flash ; anthropic -> claude-haiku-5-5 / claude-sonnet-5-5
FINN_LLM_FAST_MODEL=
FINN_LLM_SMART_MODEL=
# Required for provider=openai (e.g. https://api.groq.com/openai/v1 or https://openrouter.ai/api/v1)
FINN_LLM_BASE_URL=
FINN_LLM_MAX_CALLS_PER_RESEARCH=8

# Offline development with synthetic fixtures (shows a banner). Keep 0 in production.
FINN_FIXTURE_MODE=0
FINN_DATA_DIR=./var
FINN_HTTP_TIMEOUT_S=20
FINN_MAX_PDF_MB=40
FINN_CORS_ORIGINS=*
